# CHUAN-DI (ชวนดิ!) Environment Variables
# Copy this file to .env.local for local development or configure in your hosting provider

# Runtime environment (development | production)
NODE_ENV=development
PORT=3000

# Secret key for signing HTTP-only JWT authentication cookies
# REQUIRED in production: replace with a strong random 32+ character secret
JWT_SECRET=chuan-di-super-secret-key-change-me

# Public base URL used when displaying/copying shareable RSVP and invitation links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Server-side LLM API Keys for AI Text Extraction
# Never expose these with NEXT_PUBLIC_ prefixes!
# If neither key is configured, CHUAN-DI automatically uses its built-in Thai/English NLP Rule-Based Fallback Engine.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: Supabase PostgreSQL credentials (when deploying with Supabase instead of embedded SQLite)
# Schema & RLS migrations are located in ./supabase/migrations/001..005.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Google Calendar OAuth 2.0 Integration (Server-side only)
# See docs/GOOGLE_CALENDAR_SETUP.md for step-by-step setup instructions.
# Never expose GOOGLE_CLIENT_SECRET or GOOGLE_TOKEN_ENCRYPTION_KEY with NEXT_PUBLIC_!
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google-calendar/callback
# Optional 32+ char key for encrypting stored Google OAuth tokens at rest (falls back to JWT_SECRET if omitted)
GOOGLE_TOKEN_ENCRYPTION_KEY=
